# ============================================================
# PROTOCEM - Variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores.
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# Nunca subas el .env real al repositorio.
# ============================================================

# ===== Entorno de ejecucion =====
# development | production | test
NODE_ENV=development

# ===== Servidor HTTP =====
# Puerto en el que escucha la aplicacion.
PORT=3000

# ============================================================
# BASE DE DATOS MySQL
# ============================================================
# Opcion A (local): parametros individuales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=protocem_db
DB_POOL_SIZE=10

# Opcion B (nube): URL unificada.
# Si DATABASE_URL tiene valor, tiene prioridad sobre DB_HOST, DB_PORT,
# DB_USER, DB_PASSWORD y DB_NAME.
#
# Formato general:
# DATABASE_URL=mysql://usuario:contrasena@host:3306/protocem_db
#
# Ejemplos:
# DATABASE_URL=mysql://protocem:secreto@db.example.com:3306/protocem_db
# DATABASE_URL=mysql://protocem:secreto@db.example.com:3306/protocem_db?ssl=true
# DATABASE_URL=mysql://protocem:secreto@db.example.com:3306/protocem_db?sslmode=require
# DATABASE_URL=mysql://protocem:secreto@db.example.com:3306/protocem_db?ssl={"rejectUnauthorized":false}
#
# Deja la variable comentada o vacia para usar los parametros DB_*.
# DATABASE_URL=

# ----- SSL para MySQL en la nube -----
# false en local. En la nube suele ser true o required.
# Valores aceptados: true, false, required, verify-ca, verify-identity.
DB_SSL=false

# Verifica el certificado del servidor. Mantener true en produccion.
# Usa false solo si el proveedor no ofrece un CA valido y confias en la red.
DB_SSL_REJECT_UNAUTHORIZED=true

# Ruta al certificado CA del proveedor (opcional).
# Puede ser una ruta relativa al proyecto o una ruta absoluta.
# DB_SSL_CA=./certs/ca.pem

# ============================================================
# SEGURIDAD
# ============================================================
# Clave para firmar los JWT. Usa una cadena aleatoria de al menos 32
# caracteres en produccion. Para generarla:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-cambia-esta-clave-antes-de-produccion
JWT_EXPIRES_IN=8h

# Costo de bcrypt (10-12 recomendado).
BCRYPT_ROUNDS=10

# ============================================================
# CORS
# ============================================================
# * permite cualquier origen (solo para local).
# En produccion usa una lista separada por comas:
# CORS_ORIGIN=https://protocem.example.com,https://admin.protocem.example.com
CORS_ORIGIN=*

# ============================================================
# IMPORTACION DE PRESUPUESTOS OPUS
# ============================================================
# Tamano maximo del Excel en bytes (10 MB por defecto).
UPLOADS_MAX_SIZE=10485760

# Tiempo de vida de la vista previa temporal en milisegundos (1 hora).
IMPORT_PREVIEW_TTL_MS=3600000

# Maximo de filas de materiales que procesa el parser.
IMPORT_MAX_ROWS=5000

# ============================================================
# SCRIPTS OPCIONALES
# ============================================================
# Ruta base de las matrices de Opus para scripts/import-opus.js.
# OPUS_DATA_PATH=C:/ruta/a/matrices
